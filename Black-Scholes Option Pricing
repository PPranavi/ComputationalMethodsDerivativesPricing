    "def psi_k(k, a, b, c, d):\n",
    "    \"\"\"Integral of cos(k*pi*(y-a)/(b-a)) from c to d\"\"\"\n",
    "    if k == 0:\n",
    "        return d-c\n",
    "    term = k*np.pi/(b-a)\n",
    "    return (np.sin(term*(d-a))-np.sin(term*(c-a)))/term"
   ]

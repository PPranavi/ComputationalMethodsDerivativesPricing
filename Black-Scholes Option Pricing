    "#Characteristic function of the log of stock price in the Black-Scholes framework\n",
    "def cf_bs(u, S0, r, q, sigma, T):\n",
    "    s0 = np.log(S0)\n",
    "    mu = s0 + (r-q-0.5*sigma**2)*T\n",
    "    return np.exp(1j*u*mu-0.5*sigma**2*u**2*T)"
   ]
  },

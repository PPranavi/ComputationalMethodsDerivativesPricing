    "#(c) Fourier-cosine Method\n",
    "def chi_k(k, a, b, c, d):\n",
    "    if k == 0:\n",
    "        return np.exp(d)-np.exp(c)\n",
    "    term = k*np.pi/(b-a)\n",
    "    denom = 1+term**2\n",
    "    val = (np.cos(term*(d-a))*np.exp(d)-np.cos(term*(c-a))*np.exp(c)\n",
    "           +term*np.sin(term*(d-a))*np.exp(d)-term*np.sin(term*(c-a))*np.exp(c))/denom\n",
    "    return val"
   ]
  },
